# Server Port
PORT=3000

# Meta Instagram Webhook Verification Token
# Set this to a random secret string that matches your Meta Developer Dashboard
META_VERIFY_TOKEN=change-this-to-a-random-secret

# Meta Instagram Access Token
# Store your real token here (Do NOT expose or commit)
META_INSTAGRAM_ACCESS_TOKEN=##############

# Meta Graph API Version
META_GRAPH_API_VERSION=v22.0

# Admin Authentication Settings
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=##############
ADMIN_JWT_SECRET=##############

# Web Push (VAPID) Settings for Phone Push Notifications
VAPID_PUBLIC_KEY=##############
VAPID_PRIVATE_KEY=##############
VAPID_SUBJECT=mailto:admin@example.com

# Environment
NODE_ENV=development
